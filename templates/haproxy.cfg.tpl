# HAProxy Configuration — Generated by Terraform
# DO NOT EDIT MANUALLY
# Balances TCP 6443 (K8s API) across all master nodes

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # Default SSL material
    ca-base /etc/ssl/certs
    crl-base /etc/ssl/private

    # Default: ciphers used by default
    ssl-default-bind-ciphers kEECDH:aRSA:kEDH:aRSA:+3DES
    ssl-default-bind-options no-sslv3

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    retries 3
    timeout connect 5000
    timeout client 50000
    timeout server 50000
    maxconn 30000

# Frontend: kubectl / kubeadm connect here
frontend k8s_api_frontend
    bind *:6443
    default_backend k8s_masters

# Backend: K8s API servers (masters)
backend k8s_masters
    balance roundrobin
    # Generated master server entries:
    %{ for ip in master_ips ~}
    server master-${ip} ${ip}:6443 check fall 3 rise 2
    %{ endfor ~}