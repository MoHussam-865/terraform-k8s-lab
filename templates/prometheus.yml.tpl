# Prometheus Configuration — Generated by Terraform
# DO NOT EDIT MANUALLY
# Scrapes Node Exporter port 9100 on all masters, workers, haproxy, and ansible controller

global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Alerting (optional — configure alertmanager for production)
alerting:
  alertmanagers: []

# Rule files for aggregated alerting
rule_files: []

# Data source: where Prometheus stores time-series data
data_source:
  ds_type: prometheus
  ds_config:
    data_path: /var/lib/prometheus/data

# Scrape configuration
scrape_configs:
  - job_name: "k8s-masters"
    scrape_interval: 15s
    static_targets:
      %{ for ip in master_ips ~}
      - target: ${ip}:9100
        labels:
          group: masters
          role: control-plane
      %{ endfor ~}

  - job_name: "k8s-workers"
    scrape_interval: 15s
    static_targets:
      %{ for ip in worker_ips ~}
      - target: ${ip}:9100
        labels:
          group: workers
          role: worker
      %{ endfor ~}

  - job_name: "haproxy-lb"
    scrape_interval: 15s
    static_targets:
      %{ for ip in haproxy_ips ~}
      - target: ${ip}:9100
        labels:
          group: haproxy
          role: load-balancer
      %{ endfor ~}

  - job_name: "ansible-controller"
    scrape_interval: 15s
    static_targets:
      - target: ${ansible_ip}:9100
        labels:
          group: ansible
          role: controller

# Web UI
web:
  listen: 0.0.0.0:9090
  tls: false