# =============================================================================
# FILE:        terraform.tfvars.example
# PURPOSE:     Template for the terraform.tfvars file. Shows the expected
#              format without exposing real values.
# LOADED:      NEVER — this is just an example. The real terraform.tfvars
#              (if it exists) is loaded automatically by Terraform.
# OPTIONAL:    Yes, but every production project should have one.
# DEPENDS ON:  variables.tf (defines which variables exist)
#
# HOW TO USE THIS FILE:
#
#   1. COPY this file to terraform.tfvars (the real file):
#        cp terraform.tfvars.example terraform.tfvars
#
#   2. EDIT terraform.tfvars with your actual values:
#        - Optionally change key_name (a default of "k8s-lab-key" is used otherwise)
#        - Or change instance_type, region, etc.
#
#   3. The real terraform.tfvars is in .gitignore — it will NEVER be
#      committed. This protects your configuration details.
#
# WHY SEPARATE VARIABLES FROM CODE:
#
#   1. SECURITY: Variables can contain sensitive-ish information
#      (instance types, region preferences, naming conventions).
#      These aren't "secrets" like passwords, but they reveal your
#      infrastructure design. Keeping them separate means your
#      open-source code stays generic.
#
#   2. ENVIRONMENT DIFFERENCES: A single set of .tf files can be
#      used across dev, staging, and prod by providing different
#      .tfvars files:
#        terraform apply -var-file=dev.tfvars
#        terraform apply -var-file=prod.tfvars
#
#   3. COLLABORATION: Each team member can have their own .tfvars
#      with their own key_name, without modifying shared code.
#
#   4. CI/CD: The pipeline injects variables via environment variables
#      or -var-file, never by modifying .tf files.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS REGION
# Change if you prefer a different region.
# All regions: us-east-1, us-east-2, us-west-1, us-west-2, eu-west-1, etc.
# -----------------------------------------------------------------------------
# aws_region = "us-east-1"

# -----------------------------------------------------------------------------
# SSH KEY PAIR — OPTIONAL. Terraform auto-creates the key pair with a
# sensible default name ("k8s-lab-key"). If you want a custom name,
# uncomment and change the line below.
#
# The private key is auto-saved to ~/.ssh/<key_name>.pem for SSH access.
#
# Example:
#   key_name = "my-k8s-key"
# -----------------------------------------------------------------------------
# key_name = "k8s-lab-key"

# -----------------------------------------------------------------------------
# INSTANCE TYPE
# t3.small is the recommended default for this K8s lab (2 vCPU, 2 GB RAM).
# Alternatives: t3.medium (4 GB RAM), t3a.small (AMD EPYC, cheaper)
# -----------------------------------------------------------------------------
# instance_type = "t3.small"

# -----------------------------------------------------------------------------
# UBUNTU VERSION
# jammy  = 22.04 LTS (recommended, most battle-tested)
# noble  = 24.04 LTS (newer, less tested with K8s tooling)
# focal  = 20.04 LTS (older, approaching EOL)
# -----------------------------------------------------------------------------
# ubuntu_codename = "jammy"

# -----------------------------------------------------------------------------
# VPC & SUBNET CIDRs
# Change only if 10.1.0.0 conflicts with existing VPCs in your account.
# -----------------------------------------------------------------------------
# vpc_cidr    = "10.1.0.0/24"
# subnet_cidr = "10.1.0.0/26"

# -----------------------------------------------------------------------------
# YOUR PUBLIC IP (REQUIRED)
# This is REQUIRED — no default. Terraform will prompt you if not set.
# It restricts SSH and admin UI access to ONLY your IP address.
# Get your IP: curl ifconfig.me  or  visit whatismyip.com
# Format: <your-ip>/32  (e.g., "203.0.113.5/32")
# -----------------------------------------------------------------------------
# my_public_ip = "203.0.113.5/32"

# -----------------------------------------------------------------------------
# SCALABLE INSTANCE COUNTS
# Change these to scale your cluster. Only NEW instances are created/destroyed.
# -----------------------------------------------------------------------------
# master_count  = 3   # Must be odd (etcd quorum): 1, 3, 5, 7...
# worker_count  = 2   # Minimum: 1
# haproxy_count = 1   # Minimum: 1

# -----------------------------------------------------------------------------
# ROOT VOLUME SIZE (GB)
# 20 GB is sufficient. Increase if you plan to store large container images.
# -----------------------------------------------------------------------------
# root_volume_size = 20