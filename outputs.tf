# =============================================================================
# FILE:        outputs.tf
# PURPOSE:     Expose useful values after `terraform apply` completes.
#              Outputs are the "return values" of your Terraform project.
# LOADED:      Evaluated after resources are created/updated.
# DEPENDS ON:  ec2.tf, networking.tf, security.tf
#
# WHAT OUTPUTS DO:
#   1. Display values at the end of `terraform apply`
#   2. Queried: `terraform output <name>` or `terraform output -json`
#   3. Used by other Terraform projects via terraform_remote_state
#   4. Consumed by scripts: `terraform output -json | jq ...`
#   5. Self-document what your project produces
# =============================================================================

# =============================================================================
# VPC & NETWORKING OUTPUTS
# =============================================================================

output "vpc_id" {
  description = "ID of the VPC created for the Kubernetes lab"
  value       = aws_vpc.main.id
}

output "subnet_id" {
  description = "ID of the public subnet where all instances live"
  value       = aws_subnet.public.id
}

output "security_group_id" {
  description = "ID of the security group applied to all lab instances"
  value       = aws_security_group.k8s_lab.id
}

# =============================================================================
# INSTANCE OUTPUTS
# =============================================================================

# EC2 instance IDs — for AWS CLI operations
# Usage: aws ec2 stop-instances --instance-ids $(terraform output -json instance_ids | jq -r '.["ansible-controller"]')
output "instance_ids" {
  description = "Map of instance names to their EC2 instance IDs"
  value = {
    for name, instance in aws_instance.this :
    name => instance.id
  }
}

# Public IPv4 addresses — for SSH access from your local machine
# Usage: ssh -i ~/.ssh/your-key.pem ubuntu@<public-ip>
output "public_ips" {
  description = "Map of instance names to their public IPv4 addresses (for SSH)"
  value = {
    for name, instance in aws_instance.this :
    name => instance.public_ip
  }
}

# Private IPv4 addresses — FIXED (from locals.tf), for Ansible inventory.
# These NEVER change between destroy/apply cycles.
# Ansible inventory:
#   [control_plane]
#   10.1.0.10
#   [workers]
#   10.1.0.6
#   10.1.0.8
output "private_ips" {
  description = "Map of instance names to their fixed private IPv4 addresses"
  value = {
    for name, instance in aws_instance.this :
    name => instance.private_ip
  }
}

# Public DNS hostnames — alternative to IPs for SSH
output "public_dns" {
  description = "Map of instance names to their public DNS hostnames"
  value = {
    for name, instance in aws_instance.this :
    name => instance.public_dns
  }
}
# =============================================================================
# ANSIBLE INVENTORY — Ready-to-use inventory file
#
# Pipe directly to a file:
#   terraform output -raw ansible_inventory > hosts.ini
# =============================================================================
output "ansible_inventory" {
  description = "Ansible inventory file content in INI format"

  value = indent(2, <<-EOT
    # Kubernetes Lab Ansible Inventory
    # Generated by Terraform — DO NOT EDIT MANUALLY
    # Run: terraform output -raw ansible_inventory > hosts.ini

    [ansible_controller]
    ${aws_instance.this["ansible-controller"].public_ip} ansible_user=ubuntu private_ip=${aws_instance.this["ansible-controller"].private_ip}

    [control_plane]
    ${aws_instance.this["control-plane-01"].public_ip} ansible_user=ubuntu private_ip=${aws_instance.this["control-plane-01"].private_ip}

    [workers]
    ${aws_instance.this["worker-01"].public_ip} ansible_user=ubuntu private_ip=${aws_instance.this["worker-01"].private_ip}
    ${aws_instance.this["worker-02"].public_ip} ansible_user=ubuntu private_ip=${aws_instance.this["worker-02"].private_ip}

    [k8s_cluster:children]
    control_plane
    workers

    [all:vars]
    ansible_python_interpreter=/usr/bin/python3
  EOT
  )
}